# Copy this file to `.env` and adjust as needed.

# Server
PORT=4000

# MongoDB (local instance)
MONGO_URI=mongodb://127.0.0.1:27017/mandir

# Room / gate configuration
CAPACITY=30
GATE_HIGH=30   # close the gate when occupancy reaches this
GATE_LOW=10    # reopen the gate when occupancy drops to this

# Auth (admin panel)
JWT_SECRET=change-me-in-production
